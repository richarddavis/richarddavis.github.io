{% assign research = data[1] | sort: 'startDate' | reverse %}
<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in research %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 date-column">
          {% if content.startDate and content.startDate != '' %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' | append: endDate %}
          {% else %}
            {% assign date = content.endDate | split: '-' | slice: 0, 2 | join: '.' %}
          {% endif %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
          {% if content.location %}
            <p class="location"><i class="fa-solid fa-location-dot iconlocation"></i>{{ content.location }}</p>
          {% endif %}
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url and content.url != '' %}
              <a href="{{ content.url }}">{{ content.position }}</a>
            {% else %}
              {{ content.position }}
            {% endif %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.organization }}</h6>
          {% if content.projects %}
            {% for proj in content.projects %}
              <p class="font-weight-bolder ml-1 ml-md-4 mt-2 mb-0">Project: {{ proj.name }}</p>
              {% if proj.investigators %}
                <p class="font-weight-bolder ml-1 ml-md-4 mb-0">Project Investigators: {{ proj.investigators }}</p>
              {% endif %}
              <ul class="items">
                {% for item in proj.highlights %}
                  <li>
                    <span class="item">{{ item }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endfor %}
          {% elsif content.highlights %}
            <ul class="items">
              {% for item in content.highlights %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
