<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign service = data[1] | sort: 'startDate' | reverse %}
  {% for content in service %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 date-column">
          {% if content.startDate %}
            {% assign startYear = content.startDate | slice: 0, 4 %}
            {% assign endYear = content.endDate | slice: 0, 4 %}
            {% if endYear == '' or endYear == startYear %}
              {% assign date = startYear %}
            {% else %}
              {% assign date = startYear | append: ' - ' | append: endYear %}
            {% endif %}
          {% else %}
            {% assign date = '' %}
          {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {{ content.position }}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.organization }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
