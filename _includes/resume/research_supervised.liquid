{% assign doctoral = data[1] | where: 'category', 'doctoral' | sort: 'startDate' | reverse %}
{% assign graduate = data[1] | where: 'category', 'graduate' | sort: 'endDate' | reverse %}

<h5 class="font-italic">Doctoral Advising</h5>
<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in doctoral %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 date-column">
          {% if content.startDate and content.startDate != '' %}
            {% assign date_start = content.startDate %}
            {% if content.endDate and content.endDate != '' %}
              {% assign date_end = content.endDate %}
            {% else %}
              {% assign date_end = 'Present' %}
            {% endif %}
            {% assign date = date_start | append: ' - ' | append: date_end %}
          {% elsif content.endDate %}
            {% assign date = content.endDate %}
          {% else %}
            {% assign date = '' %}
          {% endif %}
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
          {% if content.location %}
            <p class="location mt-1">
              <i class="fa-solid fa-location-dot iconlocation"></i>
              {{ content.location }}
            </p>
          {% endif %}
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">{{ content.name }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.institution }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.title }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>

