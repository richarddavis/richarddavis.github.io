---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% assign resume_data = site.data.industry_resume %}
      {% for data in resume_data %}
        {% if site.jsonresume and site.jsonresume.size > 0 %}
          {% unless site.jsonresume contains data[0] %}
            {% continue %}
          {% endunless %}
        {% endif %}
        {% if data[0] == 'meta' or data[1].size == 0 %} {% continue %} {% endif %}
        <a class="anchor" id="{{ data[0] }}"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ data[0] | capitalize }}</h3>
          <div>
            {% case data[0] %}
              {% when 'basics' %}
                {% include resume/basics.liquid data=data %}
              {% when 'education' %}
                {% include resume/education.liquid data=data %}
              {% when 'work' %}
                {% include resume/work.liquid data=data %}
              {% when 'volunteer' %}
                {% include resume/volunteer.liquid data=data %}
              {% when 'projects' %}
                {% include resume/projects.liquid data=data %}
              {% when 'awards' %}
                {% include resume/awards.liquid data=data %}
              {% when 'skills' %}
                {% include resume/skills.liquid data=data %}
              {% when 'publications' %}
                {% comment %} Change back to publications.liquid to display list of publications {% endcomment %}
                {% include resume/link-to-publications.liquid data=data %}
              {% when 'languages' %}
                {% include resume/languages.liquid data=data %}
              {% when 'interests' %}
                {% include resume/interests.liquid data=data %}
              {% when 'certificates' %}
                {% include resume/certificates.liquid data=data %}
              {% when 'references' %}
                {% include resume/references.liquid data=data %}
              {% when 'leadership' %}
                {% include resume/leadership.liquid data=data %}
              {% when 'peer review' %}
                {% include resume/peer_review.liquid data=data %}
              {% when 'professional service' %}
                {% include resume/professional_service.liquid data=data %}
              {% when 'research supervised' %}
                {% include resume/research_supervised.liquid data=data %}
              {% when 'academic consulting' %}
                {% include resume/consulting.liquid data=data %}
              {% when 'university teaching experience' %}
                {% include resume/university_teaching_experience.liquid data=data %}
              {% when 'funding' %}
                {% include resume/funding.liquid data=data %}
              {% when 'industry experience' %}
                {% include resume/industry_experience.liquid data=data %}
              {% when 'research experience' %}
                {% include resume/research_experience.liquid data=data %}
              {% when 'professional development' %}
                {% include resume/professional_development.liquid data=data %}
              {% else %}

            {% endcase %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>